# Public URL used for canonical metadata and social sharing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only ProcuraX API base URL. Keep the /api/v1 prefix and omit a trailing slash.
API_BASE_URL=https://procurex-backend-du0l.onrender.com/api/v1

# Match this to the backend refresh-token lifetime (1-365 days).
AUTH_REFRESH_COOKIE_MAX_AGE_DAYS=30

# Assignment/evaluation workspaces. Set false to remove one-click demo access.
DEMO_ACCESS_ENABLED=false
# Enable only for temporary evaluation environments. Never use production credentials here.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
DEMO_SUPPLIER_EMAIL=
DEMO_SUPPLIER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
